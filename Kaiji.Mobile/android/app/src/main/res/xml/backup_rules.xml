<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: Android's backup has everything but the sync password. Its key stays in
     this phone's Keystore, so a restored copy of it couldn't be read anyway. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
</full-backup-content>
